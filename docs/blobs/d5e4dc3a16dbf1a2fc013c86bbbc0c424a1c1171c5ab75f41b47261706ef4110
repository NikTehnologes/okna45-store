"""Example third-party Okna45 window; imports only the public application API."""
from ok45_api import Application, ENTER


class Main(Application):
    title = 'Counter'
    interval_ms = 1000

    def __init__(self, context, window):
        super().__init__(context, window)
        self.value = int(context.load_json(default={'value': 0}).get('value', 0))
        self.status = 'Enter / Add increments'

    def controls(self):
        return self.toolbar((('add', 'Add'), ('reset', 'Reset'), ('save', 'Save')))

    def activate(self, control):
        if control['action'] == 'add':
            self.value += 1
        elif control['action'] == 'reset':
            self.value = 0
        elif control['action'] == 'save':
            self.context.save_json({'value': self.value})
            self.status = 'Saved in /data/counter'
        self.invalidate()

    def key(self, code):
        if code == ENTER:
            self.activate({'action': 'add'})

    def semantic(self):
        return {'value': self.value, 'status': self.status,
                'lines': ['Okna45 application API v1', 'Count: %d' % self.value, self.status]}
