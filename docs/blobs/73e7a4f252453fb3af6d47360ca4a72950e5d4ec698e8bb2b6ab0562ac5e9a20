"""Pico client for messenger v2. GET consumes the queue; keep a local receipt first."""
import gc
import binascii
import ok45_fs as fs
from ok45_api import Application, ENTER, UP, DOWN, BACKSPACE, DELETE, ticks_ms, ticks_add, ticks_diff
from ok45_api import LIGHT, WHITE, BLACK, NAVY

SERVER = 'https://zx700ai.alwaysdata.net/'
MAX_INBOX = 32768
RUS = 'абвгдеёжзийклмнопрстуфхцчшщъыьэюя'
LAT = ('a', 'b', 'v', 'g', 'd', 'e', 'yo', 'zh', 'z', 'i', 'y', 'k', 'l', 'm', 'n', 'o',
       'p', 'r', 's', 't', 'u', 'f', 'kh', 'ts', 'ch', 'sh', 'sch', '', 'y', '', 'e', 'yu', 'ya')


def screen(text):
    out = []
    for ch in text:
        code = ord(ch)
        upper = 1040 <= code <= 1071 or code == 1025
        lower = 1105 if code == 1025 else code + 32 if upper else code
        if 1072 <= lower <= 1103 or lower == 1105:
            part = LAT[RUS.find(chr(lower))]
            out.append(part.upper() if upper else part)
        elif ch == '\n' or 32 <= ord(ch) <= 126:
            out.append(ch)
        elif ch == '\t':
            out.append(' ')
        elif ch != '\r':
            out.append('?')
    return ''.join(out)


def uuid_ok(value):
    return (isinstance(value, str) and len(value) == 36 and
            all(c == '-' if i in (8, 13, 18, 23) else c in '0123456789abcdef'
                for i, c in enumerate(value)))


def fresh_id():
    from os import urandom
    data = bytearray(urandom(16))
    data[6], data[8] = (data[6] & 15) | 64, (data[8] & 63) | 128
    text = binascii.hexlify(data).decode()
    return '-'.join((text[:8], text[8:12], text[12:16], text[16:20], text[20:]))


def server_ok(value):
    return (isinstance(value, str) and 10 <= len(value) <= 160 and
            (value.startswith('https://') or value.startswith('http://')) and value.endswith('/') and
            all(33 <= ord(c) <= 126 and c not in '\\?#' for c in value) and
            '@' not in value and '..' not in value and value.split('/')[2] != '')


def decode(text):
    if not text:
        return ''
    core = text.rstrip('=')
    padding = len(text) - len(core)
    if (len(text) > 1368 or len(core) % 4 == 1 or padding > 2 or
            any(c not in 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_' for c in core) or
            (padding and (len(text) % 4 or padding != (-len(core)) % 4))):
        raise ValueError('Invalid URL-safe Base64; raw inbox kept')
    data = binascii.a2b_base64((core.replace('-', '+').replace('_', '/') + '=' * ((-len(core)) % 4)).encode())
    if len(data) > 1024:
        raise ValueError('Message exceeds 1024 bytes; raw inbox kept')
    return data.decode('utf-8')


def json_cost(text):
    return sum(1 if 32 <= ord(c) < 127 and c not in '\\"' else
               2 if c in '\\"\n\r\t\b\f' else 6 if ord(c) < 65536 else 12 for c in text)


class Reader:
    """Small parser for the supplied server's {status,b64urlm}; never loads its list."""
    def __init__(self, file):
        self.file, self.buffer, self.index, self.peek = file, b'', 0, None

    def take(self):
        if self.peek is not None:
            code, self.peek = self.peek, None
            return code
        if self.index >= len(self.buffer):
            self.buffer, self.index = self.file.read(256), 0
            if not self.buffer:
                return -1
        code = self.buffer[self.index]
        self.index += 1
        return code

    def space(self):
        code = self.take()
        while code in (9, 10, 13, 32):
            code = self.take()
        return code

    def expect(self, code):
        if self.space() != code:
            raise ValueError('Incomplete/invalid inbox JSON; original kept')

    def string(self, limit):
        self.expect(34)
        data = bytearray()
        while True:
            code = self.take()
            if code == 34:
                return data.decode()
            if not 32 <= code <= 126 or code == 92 or len(data) >= limit:
                raise ValueError('Inbox string invalid/too long; original kept')
            data.append(code)

    def messages(self):
        self.expect(123)
        seen = 0
        while True:
            key = self.string(16)
            self.expect(58)
            if key == 'status' and not seen & 1:
                if self.string(16) != 'ok':
                    raise ValueError('Server status is not ok')
                seen |= 1
            elif key == 'b64urlm' and not seen & 2:
                seen |= 2
                code = self.space()
                if code == 34:
                    self.peek = code
                    text = self.string(1368)
                    if text and text != 'MessageNotFound':
                        yield decode(text)
                elif code == 91:
                    code = self.space()
                    if code != 93:
                        self.peek = code
                        while True:
                            yield decode(self.string(1368))
                            code = self.space()
                            if code == 93:
                                break
                            if code != 44:
                                raise ValueError('Invalid inbox array')
                else:
                    raise ValueError('Invalid b64urlm payload')
            else:
                raise ValueError('Unexpected/duplicate inbox field')
            code = self.space()
            if code == 125:
                break
            if code != 44:
                raise ValueError('Invalid inbox object')
        if seen != 3 or self.space() != -1:
            raise ValueError('Incomplete/trailing inbox JSON')


class Main(Application):
    title = 'Messenger v2 Lite'
    interval_ms = 500

    def __init__(self, context, window):
        super().__init__(context, window)
        number = context.read_text('number.txt', '', 64).strip()
        if number and not uuid_ok(number):
            raise ValueError('Invalid saved UUID; original number.txt kept')
        self.number = number or fresh_id()
        if not number:
            context.save_text('number.txt', self.number)
        settings = context.load_json(default={'server': SERVER})
        if not isinstance(settings, dict) or not server_ok(settings.get('server')):
            raise ValueError('Invalid server settings; original file kept')
        self.server = settings['server']
        contacts = context.load_json('data.json', [])
        if (not isinstance(contacts, list) or len(contacts) > 8 or
                any(not uuid_ok(v) or v == self.number for v in contacts) or len(set(contacts)) != len(contacts)):
            raise ValueError('Invalid contacts; original data.json kept')
        self.contacts, self.selected = contacts, 0
        self.peer, self.history, self.draft, self.receipt = None, [], '', ''
        self.page, self.edit, self.lines, self.scroll = 'contacts', '', [], 0
        self.busy, self.task, self.dirty, self.polling = False, None, False, False
        self.confirm, self.pending_action, self.operation = False, None, ''
        self.next_poll = ticks_ms()
        self.status = '8 contacts; open chat for live 500ms'
        if self.inbox():
            self.status = 'Saved inbox pending: Sync before polling'

    def inbox(self):
        for name in ('inbox.json', 'inbox.part'):
            path = self.context.data_path(name)
            if fs.exists(path):
                return path
        return None

    def chat_path(self, peer):
        return self.context.data_path('chats/' + peer + '.json')

    def load_chat(self, peer):
        value = fs.load_json(self.chat_path(peer), 8192, {'messages': [], 'draft': '', 'receipt': ''})
        history = value.get('messages') if isinstance(value, dict) else None
        draft = value.get('draft') if isinstance(value, dict) else None
        receipt = value.get('receipt') if isinstance(value, dict) else None
        if (not isinstance(history, list) or len(history) > 16 or
                any(not isinstance(v, list) or len(v) != 2 or v[0] not in ('i', 'y') or
                    not isinstance(v[1], str) or len(v[1].encode('utf-8')) > 1024 for v in history) or
                sum(len(v[1].encode('utf-8')) for v in history) > 4096 or
                not isinstance(draft, str) or len(draft) > 160 or any(not 32 <= ord(c) <= 126 for c in draft) or
                not isinstance(receipt, str) or len(receipt) not in (0, 16) or
                any(c not in '0123456789abcdef' for c in receipt)):
            raise ValueError('Invalid saved chat; original file kept')
        return value

    def write_chat(self, peer, history, draft, receipt):
        fs.atomic_json(self.chat_path(peer), {'messages': history, 'draft': draft, 'receipt': receipt}, 8192)

    def save(self):
        if self.peer and self.dirty:
            try:
                self.write_chat(self.peer, self.history, self.draft, self.receipt)
                self.dirty = False
            except Exception as error:
                self.status = 'Save: ' + str(error)[:64]
                self.invalidate()
                return False
        return True

    def bounded(self, history):
        while (len(history) > 16 or sum(len(v[1].encode('utf-8')) for v in history) > 4096 or
               sum(json_cost(v[1]) + 16 for v in history) > 7000):
            del history[0]

    def rows(self):
        return max(1, (self.window.client()[3] - 76) // 10)

    def rebuild(self):
        cols = max(1, (self.window.client()[2] - 32) // 8)
        rows = []
        for direction, message in self.history:
            text = ('Me: ' if direction == 'i' else 'Peer: ') + screen(message)
            for line in text.split('\n'):
                for start in range(0, max(1, len(line)), cols):
                    rows.append(line[start:start + cols])
        self.lines, self.scroll = rows, max(0, len(rows) - self.rows())
        self.invalidate()

    def controls(self):
        x, y, w, h = self.window.client()
        if self.confirm:
            return self.toolbar((('cancel', 'Keep'), ('confirm', 'Discard')))
        if self.page == 'chat':
            items = self.toolbar((('back', 'Back'), ('send', 'Send'), ('sync', 'Sync'),
                                  ('live', 'Pause' if self.polling else 'Live'),
                                  ('stop', 'Stop') if self.busy else ('save', 'Save')))
            items.append({'action': 'input', 'button': False, 'rect': [x + 3, y + h - 42, w - 6, 18]})
        elif self.page == 'contacts':
            items = self.toolbar((('add', 'Add'), ('open', 'Open'), ('id', 'My ID'), ('setup', 'Setup'), ('del', 'Del')))
            for row in range(min(self.rows(), len(self.contacts))):
                items.append({'action': 'select', 'index': row, 'button': False,
                              'rect': [x + 3, y + 18 + row * 10, w - 26, 10]})
            if self.inbox():
                items.append({'action': 'sync', 'label': 'Sync saved inbox', 'rect': [x + 3, y + h - 44, w - 6, 18]})
        elif self.page in ('add', 'setup'):
            items = self.toolbar((('back', 'Back'), ('commit', 'Save'), ('input', 'Input')))
        else:
            items = self.toolbar((('back', 'Back'),))
        for item in items:
            if item['action'] not in ('input', 'prev', 'next', 'stop', 'save', 'live'):
                item['enabled'] = not self.busy
        if self.page in ('chat', 'contacts'):
            for index, action in enumerate(('prev', 'next')):
                items.append({'action': action, 'label': '^' if index == 0 else 'v',
                              'rect': [x + w - 21, y + 18 + index * 22, 18, 18]})
        return items

    def activate(self, control):
        action = control['action']
        if self.confirm:
            if action == 'confirm':
                try:
                    if self.pending_action == 'inbox':
                        for name in ('inbox.json', 'inbox.part'):
                            fs.remove(self.context.data_path(name))
                        self.status = 'Inbox discarded; Live to resume'
                    else:
                        peer = self.contacts[self.selected]
                        contacts = [v for v in self.contacts if v != peer]
                        fs.atomic_json(self.context.data_path('data.json'), contacts, 1024)
                        self.contacts, self.selected = contacts, 0
                        self.status = 'Contact removed; saved chat kept'
                    self.confirm = False
                except Exception as error:
                    self.status = str(error)[:80]
            elif action == 'cancel':
                self.confirm = False
            self.invalidate()
            return
        if action == 'stop':
            self.polling = False
            if self.task is not None:
                self.context.cancel(self.task)
            self.busy, self.task = False, None
            self.status = 'Stopped; GET/send may have reached server'
        elif action == 'input':
            self.context.input()
        elif action == 'save':
            if self.save():
                self.status = 'Saved locally'
        elif action == 'live' and self.peer:
            if self.polling:
                self.polling = False
                self.status = 'Paused; current GET finishes saving'
            elif self.busy:
                self.status = 'Wait for the current request'
            elif self.inbox():
                self.confirm, self.pending_action = True, 'inbox'
                self.status = 'Backup inbox first! Discard loses it'
            else:
                self.polling, self.next_poll, self.status = True, ticks_ms(), 'Live 500ms'
        elif action in ('prev', 'next'):
            delta = -1 if action == 'prev' else 1
            if self.page == 'chat':
                self.scroll = max(0, min(max(0, len(self.lines) - self.rows()), self.scroll + delta))
            else:
                self.selected = max(0, min(len(self.contacts) - 1, self.selected + delta))
        elif not self.busy:
            try:
                if action == 'select':
                    self.selected = control['index']
                elif action == 'open' and self.contacts:
                    if not self.save():
                        return
                    peer = self.contacts[self.selected]
                    value = self.load_chat(peer)
                    self.peer, self.history, self.draft, self.receipt = peer, value['messages'], value['draft'], value['receipt']
                    self.page, self.polling, self.next_poll = 'chat', True, ticks_ms()
                    self.status = 'Live 500ms; Pause stops new polls'
                    self.rebuild()
                elif action == 'back':
                    if not self.save():
                        return
                    self.page, self.polling = 'contacts', False
                    self.peer, self.history, self.draft, self.lines = None, [], '', []
                elif action in ('add', 'setup', 'id'):
                    self.page, self.edit = action, self.server if action == 'setup' else ''
                    if action != 'id':
                        self.context.input()
                elif action == 'commit':
                    text = self.edit.strip()
                    if self.page == 'add':
                        text = text.lower()
                        if not uuid_ok(text) or text == self.number or text in self.contacts or len(self.contacts) >= 8:
                            raise ValueError('Need a new peer UUID; max 8 contacts')
                        contacts = self.contacts + [text]
                        fs.atomic_json(self.context.data_path('data.json'), contacts, 1024)
                        self.contacts, self.selected = contacts, len(contacts) - 1
                    else:
                        text = text.rstrip('/') + '/'
                        if not server_ok(text):
                            raise ValueError('Use a trusted http(s) server URL')
                        fs.atomic_json(self.context.data_path(), {'server': text}, 512)
                        self.server = text
                    self.page, self.edit, self.status = 'contacts', '', 'Saved; no network request'
                elif action == 'del' and self.contacts:
                    self.confirm, self.pending_action = True, 'contact'
                elif action == 'sync':
                    self.start('get')
                elif action == 'send' and self.peer and self.draft.strip():
                    self.start('send')
            except Exception as error:
                self.status = str(error)[:96]
        self.invalidate()

    def start(self, operation):
        if self.busy or fs._operation is not None:
            self.status = 'Another network/package operation is active'
            return
        if operation == 'send' and not self.save():
            self.polling = False
            return
        self.operation, self.busy = operation, True
        self.next_poll = ticks_add(ticks_ms(), 500)
        try:
            self.task = self.context.spawn('messenger-' + operation, self.job(operation, self.peer, self.draft))
        except Exception:
            self.busy = False
            raise

    def apply_inbox(self, path):
        with open(path, 'rb') as file:
            peer = file.read(36).decode()
            sep = file.read(1)
            token = file.read(16).decode()
            if (not uuid_ok(peer) or sep != b'\n' or file.read(1) != b'\n' or
                    len(token) != 16 or any(c not in '0123456789abcdef' for c in token)):
                raise ValueError('Invalid inbox receipt header; original kept')
            value = self.load_chat(peer)
            if value['receipt'] != token:
                history = list(value['messages'])
                count, size, cost = 0, 0, 0
                for text in Reader(file).messages():
                    count += 1
                    size += len(text.encode('utf-8'))
                    cost += json_cost(text) + 16
                    if count > 16 or size > 4096 or cost > 7000:
                        raise ValueError('Inbox batch exceeds history; export original first')
                    history.append(['y', text])
                    self.bounded(history)
                    yield None
                draft = self.draft if peer == self.peer else value['draft']
                if count:
                    self.write_chat(peer, history, draft, token)
                if count and peer == self.peer:
                    self.history, self.receipt, self.dirty = history, token, False
                    self.rebuild()
                self.status = 'Received %d; saved before next poll' % count
            else:
                self.status = 'Saved receipt recovered; no duplicates'
        fs.remove(path)

    def job(self, operation, peer, message):
        owner = 'messenger-%d' % self.window.id
        response, acquired, attempted = None, False, False
        part = self.context.data_path('inbox.part' if operation == 'get' else 'send.part')
        header, initial = None, b''
        try:
            fs.acquire(owner)
            acquired = True
            yield None
            while self.inbox():
                yield from self.apply_inbox(self.inbox())
            if not peer:
                return
            gc.collect()
            if hasattr(gc, 'mem_free') and gc.mem_free() < 48000:
                raise MemoryError('Low heap; close other windows')
            import urequests
            gc.collect()
            if operation == 'get':
                space = fs.os.statvfs('/')
                block = space[1] or space[0]
                reserve = (MAX_INBOX + 54 + 512 + block - 1) // block * block + 8192 + 32768
                if space[4] * block < reserve:
                    raise OSError('Low flash; destructive GET not sent')
                from os import urandom
                token = binascii.hexlify(urandom(8)).decode()
                header = (peer + '\n' + token + '\n').encode()
                attempted = True
                response = urequests.post(self.server + 'g', json={'message': peer + self.number}, timeout=10, stream=True)
                if response.status_code != 200:
                    raise OSError('GET HTTP %d; queue delivery uncertain' % response.status_code)
                if not callable(getattr(getattr(response, 'raw', None), 'read', None)):
                    raise RuntimeError('urequests needs stream=True, raw and timeout')
                size = 0
                file = None
                try:
                    while True:
                        chunk = response.raw.read(512)
                        if not chunk:
                            break
                        size += len(chunk)
                        if file is None and size <= 512:
                            initial += chunk
                        else:
                            if file is None:
                                fs.mkdirs(part.rsplit('/', 1)[0])
                                file = open(part, 'wb')
                                file.write(header)
                                file.write(initial)
                                initial = b''
                            file.write(chunk)
                        if size > MAX_INBOX:
                            raise ValueError('Inbox >32KiB; partial receipt kept, polling paused')
                        yield None
                finally:
                    if file is not None:
                        file.flush()
                        file.close()
                response.close()
                response = None
                if not fs.exists(part):
                    import json
                    empty = False
                    try:
                        value = json.loads(initial)
                        empty = (isinstance(value, dict) and value.get('status') == 'ok' and
                                 value.get('b64urlm') in ('MessageNotFound', '', []))
                    except (ValueError, UnicodeError):
                        pass
                    if empty:
                        self.status = 'Live: no new messages' if self.polling else 'Paused; inbox empty'
                        header = None
                        return
                    fs.mkdirs(part.rsplit('/', 1)[0])
                    with open(part, 'wb') as file:
                        file.write(header)
                        file.write(initial)
                        file.flush()
                    initial = b''
                fs.sync()
                path = self.context.data_path('inbox.json')
                fs.replace(part, path)
                gc.collect()
                yield from self.apply_inbox(path)
                header = None
            else:
                import json
                sent = message.strip()
                text = binascii.b2a_base64(sent.encode()).decode().strip().replace('+', '-').replace('/', '_')
                packet = {'message': json.dumps({'key': self.number + peer, 'b64urlm': text})}
                attempted = True
                response = urequests.post(self.server + 's', json=packet, timeout=10, stream=True)
                if response.status_code != 200:
                    raise OSError('Send HTTP %d' % response.status_code)
                if not callable(getattr(getattr(response, 'raw', None), 'read', None)):
                    raise RuntimeError('urequests needs stream=True, raw and timeout')
                yield from fs.receive_job(response.raw, part, 512)
                response.close()
                response = None
                value = fs.load_json(part, 512)
                if not isinstance(value, dict) or value.get('status') != 'ok':
                    raise ValueError('Send acknowledgement is not ok')
                history = self.history + [['i', sent]]
                self.bounded(history)
                draft = '' if self.draft == message else self.draft
                self.write_chat(peer, history, draft, self.receipt)
                self.history, self.draft, self.dirty = history, draft, False
                self.status = 'Sent; saved locally'
                self.rebuild()
        except Exception as error:
            self.status = str(error)[:96]
            if attempted and operation == 'send':
                self.polling = False
                self.status = 'Send uncertain; no auto retry: ' + self.status[:60]
            if self.inbox():
                self.polling = False
                self.status = 'Paused; raw inbox kept: ' + self.status[:65]
            self.next_poll = ticks_add(ticks_ms(), 5000)
        finally:
            try:
                if response is not None:
                    response.close()
            finally:
                try:
                    if operation == 'send':
                        fs.remove(part)
                    elif attempted and header is not None and not self.inbox():
                        # Unknown GET completion/cancellation: do not silently consume another batch.
                        fs.mkdirs(part.rsplit('/', 1)[0])
                        with open(part, 'wb') as file:
                            file.write(header)
                            file.write(initial)
                            file.flush()
                        fs.sync()
                        self.polling = False
                finally:
                    if operation == 'get' and header is not None and attempted:
                        self.polling = False
                    if acquired:
                        fs.release(owner)
                    self.busy, self.task = False, None
                    self.invalidate()

    def tick(self):
        if (self.page == 'chat' and self.peer and self.polling and not self.busy and
                fs._operation is None and ticks_diff(ticks_ms(), self.next_poll) >= 0):
            try:
                self.start('get')
            except Exception as error:
                self.polling, self.status = False, str(error)[:80]
                self.invalidate()

    def key(self, code):
        if self.confirm:
            return
        if code in (UP, DOWN) and self.page in ('contacts', 'chat'):
            self.activate({'action': 'prev' if code == UP else 'next'})
        elif code == ENTER:
            self.activate({'action': 'send' if self.page == 'chat' else 'open' if self.page == 'contacts' else 'commit'})
        elif self.page in ('add', 'setup') and not self.busy:
            if code in (BACKSPACE, DELETE):
                self.edit = self.edit[:-1]
            elif 32 <= code <= 126 and len(self.edit) < (36 if self.page == 'add' else 160):
                self.edit += chr(code)
        elif self.page == 'chat' and (not self.busy or self.operation == 'get'):
            if code in (BACKSPACE, DELETE):
                self.draft, self.dirty = self.draft[:-1], True
            elif 32 <= code <= 126 and len(self.draft) < 160:
                self.draft, self.dirty = self.draft + chr(code), True
        self.invalidate()

    def close(self):
        self.polling = False
        if self.busy:
            self.activate({'action': 'stop'})
        return self.save()

    def semantic(self):
        return {'page': self.page, 'my_id': self.number, 'peer': self.peer, 'contacts': self.contacts,
                'busy': self.busy, 'polling': self.polling, 'poll_ms': 500, 'pending_inbox': bool(self.inbox()),
                'draft_chars': len(self.draft), 'messages': len(self.history), 'dirty': self.dirty,
                'status': self.status, 'lines': self.lines[self.scroll:self.scroll + self.rows()]}

    def draw(self, canvas, rect):
        x, y, w, h = rect
        canvas.fill(rect, LIGHT)
        cols = max(1, (w - 8) // 8)
        if self.confirm:
            canvas.text(x + 4, y + 8, ('Discard saved inbox?' if self.pending_action == 'inbox' else 'Remove contact?')[:cols])
            canvas.text(x + 4, y + 22, 'Backup raw inbox before Discard.'[:cols])
            canvas.text(x + 4, y + 38, screen(self.status)[:cols])
        elif self.page == 'chat':
            canvas.text(x + 4, y + 3, (self.peer[:8] + (' Live 500ms' if self.polling else ' Paused'))[:cols])
            for row in range(min(self.rows(), len(self.lines) - self.scroll)):
                canvas.text(x + 4, y + 18 + row * 10, self.lines[self.scroll + row], NAVY)
            canvas.text(x + 4, y + h - 55, screen(self.status)[:cols])
            canvas.fill((x + 3, y + h - 42, w - 6, 18), WHITE)
            canvas.text(x + 5, y + h - 37, (self.draft + '_')[-max(1, (w - 12) // 8):], BLACK)
        elif self.page == 'contacts':
            canvas.text(x + 4, y + 3, 'Contacts %d/8' % len(self.contacts))
            for row in range(min(self.rows(), len(self.contacts))):
                selected = row == self.selected
                canvas.fill((x + 3, y + 18 + row * 10, w - 26, 10), NAVY if selected else WHITE)
                canvas.text(x + 5, y + 19 + row * 10, self.contacts[row][:(w - 32) // 8], WHITE if selected else BLACK)
            canvas.text(x + 4, y + h - 58, screen(self.status)[:cols])
        elif self.page == 'id':
            canvas.text(x + 4, y + 6, 'My UUID / number.txt')
            canvas.text(x + 4, y + 22, self.number[:18])
            canvas.text(x + 4, y + 34, self.number[18:])
            canvas.text(x + 4, y + 54, 'Give both lines to your friend.'[:cols])
        else:
            canvas.text(x + 4, y + 6, 'Peer UUID' if self.page == 'add' else 'Trusted server URL')
            canvas.fill((x + 3, y + 24, w - 6, 18), WHITE)
            canvas.text(x + 5, y + 29, (self.edit + '_')[-max(1, (w - 12) // 8):])
            canvas.text(x + 4, y + 52, screen(self.status)[:cols])
        self.draw_controls(canvas)
